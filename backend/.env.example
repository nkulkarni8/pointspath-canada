# backend/.env
# Copy this file to .env and fill in your values
# Never commit .env to git

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (SQLite — auto-created, no setup needed):
DATABASE_URL=sqlite:///./pointspath.db

# Production (Neon PostgreSQL — paste your connection string from Neon dashboard):
# DATABASE_URL=postgresql://user:password@host/dbname

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── CORS — add all frontend URLs (comma-separated, no spaces) ─────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Beehiiv email newsletter (optional) ──────────────────────────────────────
BEEHIIV_API_KEY=
BEEHIIV_PUB_ID=
