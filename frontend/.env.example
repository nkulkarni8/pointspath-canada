# frontend/.env.example — copy to .env.local for local dev, add all vars to Vercel for prod
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL
# Local:      http://localhost:8000
# Production: https://your-render-service.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase (auth only — NOT used for DB)
# Get from: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Analytics 4 (optional)
# Get from: analytics.google.com → Admin → Data Streams → Web → Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
